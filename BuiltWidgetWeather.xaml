<Window x:Class="BuiltWidgetWeather"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YWDesktopWidget"
        mc:Ignorable="d"
        Title="Time" Height="144" Width="144" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False" ResizeMode="NoResize" Background="Transparent">
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="CloseMenuItem" Header="关闭" Click="Close_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <Rectangle HorizontalAlignment="Center" Height="144" Stroke="Black" VerticalAlignment="Center" Width="144" MouseLeftButtonDown="Rectangle_MouseLeftButtonDown">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#7F00FF00"/>
                    <GradientStop Color="#7F00FFFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Label x:Name="Title" Content="天气" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontFamily="Noto Sans SC Black"/>
        <Label x:Name="LocationTextBlock" Content="正在获取地区……" HorizontalAlignment="Center" Margin="0,107,0,0" VerticalAlignment="Top" FontFamily="Noto Sans SC" FontWeight="Bold" FontSize="8"/>
        <Label x:Name="WeatherTextBlock" Content="正在获取温度……" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Noto Sans SC" FontWeight="Bold" FontSize="16" Margin="0,42,0,0"/>
        <Button x:Name="RefreshButton" Content="🔁刷新" HorizontalAlignment="Left" Margin="2,0,0,2" VerticalAlignment="Bottom" FontWeight="Bold" FontFamily="Noto Sans SC" FontSize="6" Click="RefreshButton_Click"/>
        <!--<Label x:Name="WindTextBlock" Content="正在获取风……" HorizontalAlignment="Center" Margin="0,93,0,0" VerticalAlignment="Top" FontFamily="Noto Sans SC" FontWeight="Bold"/>-->

    </Grid>
</Window>
